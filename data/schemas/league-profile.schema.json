{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SmallSide league profile",
  "type": "object",
  "required": ["id", "name", "age_group", "format", "reviewed_at", "sources"],
  "properties": {
    "affiliated_organizations": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "object", "required": ["name", "url"], "properties": {"name": {"type": "string", "minLength": 1}, "url": {"type": "string"}, "purpose": {"type": "string"}}}
    }
  }
}
